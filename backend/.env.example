# Copiar a .env y completar con valores reales. NUNCA commitear .env con credenciales reales.

NODE_ENV=development
PORT=4000

# Cadena de conexión de PostgreSQL (Render/Neon/Supabase la proveen al crear la BD)
DATABASE_URL="postgresql://usuario:password@localhost:5432/ecsa_sst?schema=public"

# Secreto para firmar la cookie de sesión — generar con: openssl rand -base64 48
SESSION_SECRET="reemplazar-con-un-valor-aleatorio-largo-y-unico"

# Origen permitido para CORS (URL del frontend desplegado)
CORS_ORIGIN="http://localhost:5173"

# Cookies de sesión "Secure" solo deben desactivarse en desarrollo local sin HTTPS
COOKIE_SECURE=false

# Duración de sesión en horas
SESSION_TTL_HOURS=8

# Password del usuario administrador demo generado por el seed (documentar SOLO como DEMO)
DEMO_MODE=true
